# Copy to .env.local for development, or set these where you build for production.

# Development: the API address. In a production build leave this UNSET when your
# web server forwards /api and /uploads to the backend on the same domain (recommended).
# Set it only if the API lives on a different address, e.g. https://api.example.co.ke
REACT_APP_API_URL=http://localhost:5000

# The public address of the website, used for canonical links, social previews and
# search-engine data. Set it to your real domain when building for production.
REACT_APP_SITE_URL=https://www.bluewellhorizonlimited.com
