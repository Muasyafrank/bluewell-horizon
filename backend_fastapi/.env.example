# Copy to .env and fill in. Never commit .env.

# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/bluewell

# development (default) or production. In production the server refuses to start
# with a weak SECRET_KEY, a SQLite DATABASE_URL or localhost-only CORS_ORIGINS,
# hides the /docs pages and sends HSTS.
ENVIRONMENT=development

# Signs login tokens. At least 32 random characters, e.g.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# Optional (defaults shown)
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Optional: Gmail address + an App Password. If unset, notification emails are skipped.
EMAIL_USER=
EMAIL_PASS=

# Optional: send through Gmail's web API (HTTPS) instead of SMTP, for networks and
# hosts that block mail ports. EMAIL_USER is still the sending address. Run
# `python gmail_authorize.py` once to get these (see docs/email-setup.md).
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Comma-separated origins allowed to call the API (your https site in production)
CORS_ORIGINS=http://localhost:3000

# Public address of the website, used in password-reset emails. Defaults to the
# first CORS origin.
SITE_URL=

# Set true only behind a reverse proxy (nginx) so the visitor's real address is read
# from X-Forwarded-For for rate limiting. Never true when exposed directly.
TRUST_PROXY=false
RATE_LIMIT_ENABLED=true
LOG_LEVEL=INFO

# Payment details printed on quotations. Fill in the ones you accept; a method
# with no details is not offered. Cash on delivery needs none.
PAYMENT_MPESA_PAYBILL_NUMBER=
PAYMENT_MPESA_PAYBILL_ACCOUNT=Your order number
PAYMENT_MPESA_TILL_NUMBER=
PAYMENT_MPESA_TILL_NAME=
PAYMENT_BANK_NAME=
PAYMENT_BANK_ACCOUNT_NAME=
PAYMENT_BANK_ACCOUNT_NUMBER=
PAYMENT_BANK_BRANCH=
PAYMENT_COD_ENABLED=true
